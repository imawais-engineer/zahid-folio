# =============================================================================
# Alpha Insights Portfolio — production environment
# =============================================================================
# Copy to `.env` and fill in real values. `.env` must NEVER be committed to git
# (it is listed in .gitignore). Placeholders only in this file.

# --- Site ---
# Public origin used for the sitemap.
SITE_URL=https://alphainsights.consulting

# --- PostgreSQL (local container, never exposed publicly) ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
# Application-side connection target (Docker service name inside the compose network).
POSTGRES_HOST=portfolio-postgres
POSTGRES_PORT=5432
# Optional explicit URL; if unset the app builds one from the variables above.
# DATABASE_URL=postgres://portfolio:CHANGE_ME@portfolio-postgres:5432/portfolio

# --- Uploads ---
# Where uploaded images are stored inside the container (persistent volume).
UPLOAD_DIR=/app/uploads

# --- Cookies ---
# Set to "false" ONLY for plain-HTTP local testing. Production keeps secure cookies.
# COOKIE_SECURE=true
